{
  "name": "@mathlabs/mathra-editor",
  "version": "0.1.0",
  "description": "Visual math editor components drawn by mathra: build a formula inside a box, with a cursor, empty places and palettes.",
  "keywords": ["math", "equation-editor", "latex", "web-components", "mathra"],
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/matheusmota-dev-br/mathra.git", "directory": "editor" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/model.d.ts", "default": "./dist/model.js" }
  },
  "files": ["dist"],
  "sideEffects": ["./dist/field.js", "./dist/index.js"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "node demo/serve.mjs"
  },
  "peerDependencies": { "@mathlabs/mathra": ">=1.12.0" },
  "devDependencies": { "@mathlabs/mathra": "file:../npm/pkg", "typescript": "5.9.3" }
}
